<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.lodgebilling.controller.LoginController"
      stylesheets="@style.css" prefWidth="850.0" prefHeight="550.0">

    <!-- Left Branding Panel -->
    <VBox alignment="CENTER" prefWidth="400" styleClass="login-left-pane" HBox.hgrow="ALWAYS">
        <Label text="PARADISE" textFill="WHITE" style="-fx-font-size: 36px; -fx-font-weight: 900; -fx-letter-spacing: 2px;"/>
        <Label text="LODGE &amp; RESORT" textFill="#FECACA" style="-fx-font-size: 18px; -fx-letter-spacing: 4px;"/>
        <VBox alignment="CENTER" style="-fx-padding: 40 0 0 0;">
            <Label text="ICT261 Lab System" textFill="WHITE" style="-fx-font-size: 14px; -fx-opacity: 0.8;"/>
            <Label text="Mulungushi University" textFill="WHITE" style="-fx-font-size: 12px; -fx-opacity: 0.6;"/>
        </VBox>
    </VBox>

    <!-- Right Login Panel (Dark Mode) -->
    <VBox alignment="CENTER" prefWidth="450" styleClass="login-right-pane" spacing="25" style="-fx-padding: 50;">
        <VBox alignment="CENTER_LEFT" spacing="5">
            <Label fx:id="headerTitle" text="Welcome Back" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
            <Label fx:id="headerSubtitle" text="Please enter your details to sign in." style="-fx-text-fill: #94A3B8;"/>
        </VBox>

        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="USERNAME" styleClass="input-label"/>
                <TextField fx:id="usernameField" promptText="admin" styleClass="text-field"/>
            </VBox>

            <VBox spacing="5">
                <Label text="PASSWORD" styleClass="input-label"/>
                <PasswordField fx:id="passwordField" promptText="••••••••" styleClass="text-field"/>
            </VBox>
        </VBox>

        <Label fx:id="errorLabel" wrapText="true" style="-fx-font-size: 13px;"/>

        <VBox spacing="15" alignment="CENTER">
            <Button fx:id="actionButton" text="Sign In" onAction="#handlePrimaryAction" maxWidth="Infinity" styleClass="btn-primary"/>
            <Hyperlink fx:id="toggleLink" text="Create a new account" onAction="#toggleMode" style="-fx-text-fill: #94A3B8; -fx-underline: true;"/>
        </VBox>
    </VBox>
</HBox>