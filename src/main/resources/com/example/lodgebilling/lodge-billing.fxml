<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.lodgebilling.controller.LodgeBillingController"
            stylesheets="@style.css" prefWidth="1200.0" prefHeight="800.0">

    <left>
        <VBox styleClass="sidebar" prefWidth="250" spacing="10">
            <Label text="Paradise Lodge" styleClass="sidebar-title"/>
            <Button text="Dashboard Overview" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Button text="New Guest Billing" styleClass="sidebar-btn" maxWidth="Infinity" style="-fx-background-color: #1E293B; -fx-border-color: #EF4444; -fx-border-width: 0 0 0 4px; -fx-text-fill: white;"/>
            <Button text="Clear Form" onAction="#clearForm" styleClass="sidebar-btn" maxWidth="Infinity"/>
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Secure Logout" onAction="#logout" styleClass="sidebar-btn" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #0F172A; -fx-padding: 30; -fx-border-color: transparent;">
            <VBox spacing="30">

                <VBox spacing="15">
                    <Label text="Billing Management" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                    <HBox spacing="20">
                        <VBox styleClass="card, summary-card" prefWidth="250" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="5">
                            <Label text="Standard Rate" style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                            <Label text="K 350.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                        </VBox>
                        <VBox styleClass="card, summary-card" prefWidth="250" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="5">
                            <Label text="Deluxe Rate" style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                            <Label text="K 550.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                        </VBox>
                        <VBox styleClass="card, summary-card" prefWidth="250" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="5">
                            <Label text="Family Rate" style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                            <Label text="K 750.00" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F8FAFC;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <HBox spacing="25">
                    <VBox styleClass="card" prefWidth="550" spacing="20" HBox.hgrow="ALWAYS">
                        <Label text="Guest Registration" styleClass="card-header"/>
                        <Separator style="-fx-background-color: #334155;"/>
                        <GridPane hgap="15" vgap="15">
                            <columnConstraints>
                                <ColumnConstraints minWidth="120"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>

                            <Label text="GUEST NAME" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="input-label"/>
                            <TextField fx:id="guestNameField" promptText="e.g. John Phiri" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="ROOM TYPE" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="input-label"/>
                            <ComboBox fx:id="roomTypeCombo" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="NIGHTS STAYED" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="input-label"/>
                            <TextField fx:id="nightsField" promptText="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="EXTRAS (K)" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="input-label"/>
                            <TextField fx:id="extrasField" promptText="0.00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="AMOUNT PAID (K)" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="input-label"/>
                            <TextField fx:id="amountPaidField" promptText="0.00" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <HBox spacing="10" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-padding: 10 0 0 0;">
                                <Button text="Calculate" onAction="#calculateBill" styleClass="btn-secondary" prefWidth="120"/>
                                <Button text="Save Record" onAction="#saveBill" styleClass="btn-primary" prefWidth="120"/>
                            </HBox>
                        </GridPane>
                    </VBox>

                    <VBox styleClass="card" prefWidth="350" spacing="15">
                        <Label text="Room Preview" styleClass="card-header"/>
                        <StackPane style="-fx-background-color: #0F172A; -fx-background-radius: 8px; -fx-border-color: #334155; -fx-border-radius: 8px;">
                            <ImageView fx:id="roomImageView" fitWidth="310" fitHeight="180" preserveRatio="true"/>
                        </StackPane>
                        <Separator style="-fx-background-color: #334155;"/>
                        <VBox spacing="8">
                            <Label text="Business Rules" styleClass="input-label" style="-fx-text-fill: #EF4444;"/>
                            <Label text="• 5+ nights: 5% off room charge." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;"/>
                            <Label text="• Extras get no discount." wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #94A3B8;"/>
                        </VBox>
                    </VBox>
                </HBox>

                <VBox styleClass="card" spacing="15" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Recent Transactions" styleClass="card-header"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="statusLabel" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <TableView fx:id="billsTable" prefHeight="250" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colBillId" text="ID" prefWidth="70"/>
                            <TableColumn fx:id="colGuest" text="GUEST" prefWidth="200"/>
                            <TableColumn fx:id="colRoom" text="ROOM" prefWidth="120"/>
                            <TableColumn fx:id="colNights" text="NIGHTS" prefWidth="80"/>
                            <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="130"/>
                            <TableColumn fx:id="colPaid" text="PAID" prefWidth="130"/>
                            <TableColumn fx:id="colBalance" text="BALANCE" prefWidth="130"/>
                        </columns>
                    </TableView>
                    <HBox alignment="CENTER_RIGHT">
                        <Button text="Delete Selected" onAction="#deleteSelectedBill" style="-fx-background-color: transparent; -fx-text-fill: #EF4444; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>